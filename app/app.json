{
  "expo": {
    "name": "Mutoon Tarteel",
    "slug": "mutoon-tarteel",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "mutoon-tarteel",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-dev-client",
      [
        "@siteed/audio-studio",
        {
          "iosBackgroundMode": false,
          "microphonePermission": "Mutoon Tarteel uses the microphone to detect your recitation while memorizing."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          },
          "android": {
            "minSdkVersion": 24
          }
        }
      ],
      "expo-font",
      "expo-splash-screen",
      "expo-sharing"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mutoon.tarteel",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Mutoon Tarteel uses the microphone to detect your recitation while memorizing.",
        "NSLocalNetworkUsageDescription": "Mutoon Tarteel uses the local network to find and connect to the development server on your computer.",
        "NSBonjourServices": [
          "_expo._tcp"
        ],
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true
      }
    },
    "android": {
      "package": "com.mutoon.tarteel",
      "adaptiveIcon": {
        "backgroundColor": "#0f1419",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "asr": {
        "cloudVendor": "deepgram",
        "deepgramModel": "nova-3",
        "deepgramLanguage": "ar",
        "openaiTranscriptionModel": "gpt-realtime-whisper"
      }
    }
  }
}
